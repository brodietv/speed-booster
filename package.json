{
  "name": "speed-booster",
  "version": "2.0.0",
  "private": true,
  "description": "Speed Booster for ChatGPT — instant long chats, wide mode, outline & search, prompt library, exports, timestamps and shortcuts.",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "build": "node scripts/build.js",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
